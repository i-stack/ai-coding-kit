.DS_Store

# env/: secrets.json (keys/tokens/urls) and config.json (path overrides) are gitignored.
# env/mcp/*.json and env/platforms/*.json are committed (use ${VAR} references, no real secrets).
# User creates env/secrets.json and (optionally) env/config.json from their .example templates.
env/secrets.json
env/config.json
env/backup.json

