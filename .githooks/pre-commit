#!/usr/bin/env bash
# Root pre-commit guard for ai-coding-kit.
#
# Guards every staged change that touches a skill contract or a cross-skill
# coordination file under skills-engineering/:
#
#   All skills:
#     SKILL.md / AGENT-BRIEF.md / OUT-OF-SCOPE.md / references/*.md changes
#     must pass the mechanical structure gate
#     (scripts/validate-skill-structure.sh <skill>) and the DH-002 banned-phrase
#     scan on runnable entry docs (scripts/validate-doc-hygiene.sh <file>).
#
#   Cross-skill coordination files (.agents/*.md, source-truth.json):
#     must pass the cross-skill behavior/consistency gate
#     (scripts/validate-skill-behavior.sh).
#
# Deletions (diff-filter D) are in scope too: a deleted contract file must
# still satisfy the gates — validated by its absence (a deleted SKILL.md FAILS
# the structure gate; a deleted references/*.md must not leave dangling links).
#
# Partial staging is rejected: validators read the worktree, so a guarded file
# must be staged exactly as it exists in the worktree (unstaged diff empty),
# otherwise gates could pass against a worktree "fixed" copy while the commit
# ships the stale staged version.
#
# Bypass mode:
#   SKILL_BYPASS=1  — Skip every gate for emergencies. Must be documented in the
#                     commit message.

set -uo pipefail

if [ "${SKILL_BYPASS:-0}" = "1" ]; then
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SE_DIR="${ROOT}/skills-engineering"
SCRIPTS_DIR="${SE_DIR}/scripts"

# Deletions are in scope too: removing a contract file must not bypass the
# gates. Validators read the worktree, so a deleted file is validated by its
# absence (a deleted SKILL.md must FAIL; a deleted reference must not leave
# dangling links in SKILL.md).
changed_files="$(git diff --cached --name-only --diff-filter=ACMRD)"
deleted_files="$(git diff --cached --name-only --diff-filter=D)"

# Only paths under skills-engineering/ are in scope for this guard.
se_changed="$(printf '%s\n' "$changed_files" | grep '^skills-engineering/' || true)"

failures=0

# Guarded runnable entry docs: SKILL.md / AGENT-BRIEF.md / OUT-OF-SCOPE.md /
# references/*.md under any skill directory (governed or not).
guarded_paths="$(printf '%s\n' "$se_changed" \
  | grep -E '^skills-engineering/[^/]+/(SKILL\.md|AGENT-BRIEF\.md|OUT-OF-SCOPE\.md|references/.+\.md)$' || true)"

# Cross-skill coordination files (.agents/*.md, source-truth.json).
coord_changed="$(printf '%s\n' "$se_changed" \
  | grep -E '^skills-engineering/(\.agents/.*\.md|source-truth\.json)$' || true)"

# ─── 0. Partial-staging guard ────────────────────────────────────────────────
# Validators read the worktree (${ROOT}/<path>), so a partially staged change —
# staged blob differs from the worktree copy — could pass every gate against a
# worktree "fixed" version while the commit ships the stale staged content.
# Reject partial staging for every guarded path (structure/hygiene gates and
# the cross-skill coordination gate alike).
guard_scope="$(printf '%s\n%s\n' "$guarded_paths" "$coord_changed" | grep -v '^$' || true)"
partial=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if [ -n "$(git -C "${ROOT}" diff --name-only -- "$f")" ]; then
    echo "skill-gate pre-commit: ⚠ partially staged guarded file: ${f}" >&2
    echo "  (worktree differs from the staged version; stage it fully: git add ${f})" >&2
    partial=1
  fi
done <<EOF
$guard_scope
EOF
if [ "$partial" -eq 1 ]; then
  failures=$((failures + 1))
fi

# ─── 1. Per-skill structure + doc-hygiene gates ──────────────────────────────
if [ -n "$guarded_paths" ]; then
  # Deduplicate affected skill dirs (repo-root-relative paths).
  skill_dirs="$(printf '%s\n' "$guarded_paths" | sed -E 's#^(skills-engineering/[^/]+)/.*#\1#' | sort -u)"

  for skill_dir in $skill_dirs; do
    if [ ! -f "${ROOT}/${skill_dir}/SKILL.md" ]; then
      # Deletion-specific gate: removing SKILL.md (a skill's entry document)
      # must FAIL the structure gate — it must not be silently skipped by the
      # missing-file guard below.
      if printf '%s\n' "$deleted_files" | grep -qx "${skill_dir}/SKILL.md"; then
        echo "skill-gate pre-commit: ⚠ ${skill_dir}/SKILL.md is being DELETED — a skill's entry document must not be removed without an explicit structure-gate override." >&2
        echo "  (Restore the file, or set SKILL_BYPASS=1 for emergencies only.)" >&2
        failures=$((failures + 1))
      fi
      continue  # not a skill (directory without SKILL.md, e.g. new/placeholder)
    fi
    skill="$(basename "${skill_dir}")"

    echo "skill-gate pre-commit: structure gate for ${skill}..."
    if ! bash "${SCRIPTS_DIR}/validate-skill-structure.sh" "${skill}" >&2; then
      echo "skill-gate pre-commit: ⚠ ${skill} FAILED structure validation." >&2
      failures=$((failures + 1))
    fi

    # DH-002 banned-phrase scan on each changed runnable entry doc of this skill.
    entry_docs="$(printf '%s\n' "$guarded_paths" \
      | grep -E "^${skill_dir}/(SKILL|AGENT-BRIEF|OUT-OF-SCOPE)\.md$" || true)"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      echo "skill-gate pre-commit: DH-002 doc-hygiene scan for ${f}..."
      if ! bash "${SCRIPTS_DIR}/validate-doc-hygiene.sh" "${ROOT}/${f}" >&2; then
        echo "skill-gate pre-commit: ⚠ ${f} FAILED DH-002 banned-phrase scan." >&2
        failures=$((failures + 1))
      fi
    done <<EOF
$entry_docs
EOF
  done
fi

# ─── 3. Cross-skill coordination gate ────────────────────────────────────────
# .agents/*.md (invocation/composition matrices) and source-truth.json shape
# cross-skill consistency (trigger matrix coverage, i18n mirrors, rule-id
# ownership). These are not owned by any single skill's structure gate, so the
# cross-skill behavior/consistency validator runs when they change.
if [ -n "$coord_changed" ]; then
  echo "skill-gate pre-commit: cross-skill behavior/consistency gate (triggered by .agents/source-truth change)..."
  if ! bash "${SCRIPTS_DIR}/validate-skill-behavior.sh" >&2; then
    echo "skill-gate pre-commit: ⚠ cross-skill behavior/consistency validation FAILED." >&2
    failures=$((failures + 1))
  fi
fi

# ─── Summary ─────────────────────────────────────────────────────────────────
if [ "$failures" -gt 0 ]; then
  echo "" >&2
  echo "skill-gate pre-commit: ${failures} gate(s) failed." >&2
  echo "Resolve the issues above, or set SKILL_BYPASS=1 to bypass (emergencies only)." >&2
  exit 1
fi

exit 0