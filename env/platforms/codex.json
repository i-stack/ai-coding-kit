{
    "model": "gpt-5.5",
    "personality": "pragmatic",
    "model_provider": "dataeyes",
    "model_reasoning_effort": "medium",
    "history": {
        "persistence": "save-all"
    },
    "model_providers": {
        "dataeyes": {
            "base_url": "${codex.url}",
            "env_key": "DATAEYES_API_KEY",
            "wire_api": "responses"
        }
    },
    "features": {
        "skills": true,
        "multi_agent": true,
        "hooks": true,
        "shell_snapshot": true,
        "unified_exec": true,
        "shell_tool": true
    },
    "projects": {
        "~/Desktop/iOS/bajoseekios": {
            "trust_level": "trusted"
        },
        "~/Desktop/iOS/STBaseProject": {
            "trust_level": "trusted"
        }
    },
    "env": {
        "DATAEYES_API_KEY": "${codex.key}"
    }
}
