{
    "_comment": "Claude Code third-party API sync metadata. API credentials sync by default; set api.enabled=false to disable and clean managed API fields.",
    "api": {
        "enabled": true
    },
    "env": {
        "ANTHROPIC_AUTH_TOKEN": "${claude.token}",
        "ANTHROPIC_BASE_URL": "${claude.url}",
        "CLAUDE_CODE_EFFORT_LEVEL": "medium",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001-thinking",
        "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
    },
    "preamble": {
        "target": "CLAUDE.md",
        "mode": "full",
        "tool": "claude-code",
        "agents": true
    }
}
