{
    "name": "filesystem",
    "type": "stdio",
    "command": "/opt/homebrew/bin/npx",
    "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/Desktop/"
    ],
    "capabilities": {"authority": "local-write", "reversible": false, "data_sensitivity": "internal", "parallel_safe": false, "fallback": "use sandboxed local filesystem tools", "verification": "inspect the resolved target path after each mutation"},
    "platforms": [
        "claude",
        "codex",
        "continue"
    ]
}
