{
    "name": "playwright",
    "type": "stdio",
    "command": "npx",
    "args": [
        "-y",
        "@playwright/mcp@latest",
        "--extension"
    ],
    "env": {},
    "capabilities": {"authority": "external-write", "reversible": false, "data_sensitivity": "internal", "parallel_safe": false, "fallback": "use a read-only HTTP or local browser inspection", "verification": "observe the final page state and relevant network response"},
    "platforms": [
        "claude",
        "codex",
        "codebuddy",
        "gemini",
        "cline",
        "continue"
    ]
}
